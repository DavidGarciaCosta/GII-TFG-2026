@startuml
title Diagrama de estados - Borrador

state "Borrador" as Borrador {
[*] --> Pendiente : crear borrador de caso de prueba

Pendiente --> Pendiente : añadir feedback al borrador

Pendiente --> Rechazado : rechazar borrador
Rechazado --> Pendiente : volver a crear borrador de caso de prueba

Pendiente --> Publicado : publicar caso de prueba a partir del borrador

Rechazado --> [*] : borrador rechazado
Publicado --> [*] : caso de prueba publicado
}

@enduml