@startuml
title Diagrama de estados - CasoDeUso

state "CasoDeUso" as CasoDeUso {
[*] --> Registrado : crear caso de uso

Registrado --> Actualizado : actualizar caso de uso
Actualizado --> Registrado : guardar cambios

Registrado --> Eliminado : eliminar caso de uso

Registrado --> [*] : conservar caso de uso
Eliminado --> [*]
}

@enduml