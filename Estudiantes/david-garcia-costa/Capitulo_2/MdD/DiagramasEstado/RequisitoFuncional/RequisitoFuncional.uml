@startuml
title Diagrama de estados - RequisitoFuncional

state "RequisitoFuncional" as RequisitoFuncional {
[*] --> Registrado : crear requisito funcional

Registrado --> Actualizado : actualizar requisito funcional
Actualizado --> Registrado : guardar cambios

Registrado --> Eliminado : eliminar requisito funcional

Registrado --> [*] : conservar requisito funcional
Eliminado --> [*]
}

@enduml